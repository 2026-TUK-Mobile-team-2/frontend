<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="계정 정보"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#1A1F26" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="로그인에 사용할 정보를 입력해주세요."
        android:textSize="14sp"
        android:textColor="#718096"
        android:layout_marginTop="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="이메일 *"
        android:textStyle="bold"
        android:textColor="#555555"
        android:layout_marginTop="32dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_signup_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:hintEnabled="false"
        app:boxBackgroundMode="none"
        app:endIconMode="custom">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_signup_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="이메일을 입력해주세요"
            android:background="@drawable/bg_login_edit_text"
            android:padding="16dp"
            android:inputType="textEmailAddress"
            android:textSize="16sp"
            android:textColor="#1A1F26"/>

    </com.google.android.material.textfield.TextInputLayout>
    <TextView
        android:id="@+id/tv_email_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="4dp"
        android:textSize="13sp"
        android:textStyle="bold"
        android:text="사용 가능한 이메일입니다."
        android:textColor="#10B981"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="비밀번호 *"
        android:textStyle="bold"
        android:textColor="#555555"
        android:layout_marginTop="24dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:hintEnabled="false"
        app:boxBackgroundMode="none"
        app:passwordToggleEnabled="true"
        app:passwordToggleTint="#888888">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_signup_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="비밀번호를 입력해주세요"
            android:background="@drawable/bg_login_edit_text"
            android:padding="16dp"
            android:inputType="textPassword"
            android:textSize="16sp"
            android:textColor="#1A1F26" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="비밀번호 확인 *"
        android:textStyle="bold"
        android:textColor="#555555"
        android:layout_marginTop="24dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:hintEnabled="false"
        app:boxBackgroundMode="none"
        app:passwordToggleEnabled="true"
        app:passwordToggleTint="#888888">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_signup_password2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="비밀번호를 다시 입력해주세요"
            android:background="@drawable/bg_login_edit_text"
            android:padding="16dp"
            android:inputType="textPassword"
            android:textSize="16sp"
            android:textColor="#1A1F26" />

    </com.google.android.material.textfield.TextInputLayout>
    <TextView
        android:id="@+id/tv_password_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="4dp"
        android:textSize="13sp"
        android:textStyle="bold"
        android:text="비밀번호가 일치합니다."
        android:textColor="#10B981"
        />


</LinearLayout>