<!-- activity_map_main.xml -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E2E8F0">

    <!-- 지도 배경 -->
    <ImageView
        android:id="@+id/mapBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/main_map2" />

    <!-- 검색 + 카테고리 -->
    <LinearLayout
        android:id="@+id/topSearchArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="16dp">

        <!-- 검색바 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="@drawable/main_searchbar"
            android:elevation="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#94A3B8" />

            <EditText
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:hint="시흥시 어디든 검색"
                android:textSize="14sp"
                android:textColor="#1E293B"
                android:textColorHint="#94A3B8"
                android:background="@null"/>

        </LinearLayout>

        <!-- 카테고리 버튼 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="전체"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/main_filter_selected"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null" />

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="쓰레기"
                    android:textAllCaps="false"
                    android:textColor="#64748B"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/main_filter_unselected"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null" />

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="시설파손"
                    android:textAllCaps="false"
                    android:textColor="#64748B"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/main_filter_unselected"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null" />

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="도로"
                    android:textAllCaps="false"
                    android:textColor="#64748B"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/main_filter_unselected"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null" />

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="소음"
                    android:textAllCaps="false"
                    android:textColor="#64748B"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/main_filter_unselected"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 지도 핀들 -->
    <LinearLayout
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="260dp"
        android:layout_marginStart="60dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/hot_pin_trash"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="360dp"
        android:layout_marginStart="220dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/normal_pin_facility"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="460dp"
        android:layout_marginStart="150dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/normal_pin_safety"/>
    </LinearLayout>

    <!-- 하단 바텀시트 -->
    <LinearLayout
        android:id="@+id/bottomSheetPreview"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_above="@id/bottomNavigation"
        android:layout_alignParentBottom="false"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/bottom_sheet_bg">

        <!-- 핸들 -->

        <!-- 제목 -->
        <View
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="#CBD5E1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:text="내 주변 소식"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1E293B"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="전체보기"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#1987C2"
                android:layout_alignParentEnd="true"/>
        </LinearLayout>

        <!-- 카드 리스트 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 카드 1 -->
                <LinearLayout
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:background="@drawable/main_report_card_bg">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/trash1"
                        android:scaleType="centerCrop"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="정왕동 상가 앞 무단 투기"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:maxLines="1"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="쓰레기 💙24"
                            android:textSize="12sp"
                            android:textColor="#65C0C1"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/reportFab"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_above="@id/bottomSheetPreview"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:src="@android:drawable/ic_input_add"
        android:tint="#FFFFFF"
        android:backgroundTint="#65C0C1"
        app:fabCustomSize="64dp"
        app:maxImageSize="28dp"/>

    <!-- 하단 네비바 -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="0dp"
        android:background="@drawable/bottom_nav_bg"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/bottom_nav_selector"
        app:itemTextColor="@color/bottom_nav_selector"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_nav"
        app:itemActiveIndicatorStyle="@null"/>

</RelativeLayout>