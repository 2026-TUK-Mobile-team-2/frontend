<!-- redesigned_report_detail_screen.xml -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- 상단 앱바 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="#F8FAFC"
        android:elevation="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="민원 상세 정보"
            android:textAlignment="center"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#1E293B"/>

    </LinearLayout>

    <!-- 메인 스크롤 -->
    <ScrollView
        android:layout_below="@id/topBar"
        android:layout_above="@id/bottomActionBar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 히어로 이미지 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="280dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:id="@+id/ivHeroImage"
                    android:src="@drawable/block"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/hero_gradient_overlay"/>

                <!-- 상태 뱃지 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="20dp"
                    android:id="@+id/tvStatusBadge"
                    android:text="처리중"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#004D4E"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:background="@drawable/status_processing_badge"/>
            </FrameLayout>

            <!-- 메인 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/detail_card_bg">

                <!-- 제목 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvTitle"
                    android:text="파손된 보도블록 수리 요청"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B"/>

                <!-- 메타데이터 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/tvDate"
                        android:text="📅 2024.05.20"
                        android:textSize="13sp"
                        android:textColor="#64748B"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/tvAuthor"
                        android:text="👤 김*은"
                        android:textSize="13sp"
                        android:textColor="#64748B"
                        android:layout_marginStart="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/tvViewCount"
                        android:text="👁 1,245"
                        android:textSize="13sp"
                        android:textColor="#64748B"
                        android:layout_marginStart="16dp"/>
                </LinearLayout>

                <!-- 처리현황 -->
                <!-- 처리 현황 카드 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/progress_card_bg">

                    <!-- 제목 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="처리 현황"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="#00696B"
                        android:layout_marginBottom="20dp"/>

                    <!-- 타임라인 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- 접수완료 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:gravity="center"
                                android:id="@+id/tvStep1Circle"
                                android:text="✓"
                                android:textColor="#ffffff"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:background="@drawable/progress_complete_circle"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/tvStep1Label"
                                android:text="접수 완료"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#00696B"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>

                        <!-- 연결선 -->
                        <View
                            android:layout_width="0dp"
                            android:layout_height="2dp"
                            android:layout_weight="1"
                            android:layout_marginBottom="24dp"
                            android:id="@+id/vLine1"
                            android:background="#65C0C1"
                            android:alpha="0.3"/>

                        <!-- 처리중 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:gravity="center"
                                android:id="@+id/tvStep2Circle"
                                android:text="🛠"
                                android:textColor="#ffffff"
                                android:textSize="18sp"
                                android:background="@drawable/progress_current_circle"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/tvStep2Label"
                                android:text="처리중"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#1E293B"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>

                        <!-- 연결선 -->
                        <View
                            android:layout_width="0dp"
                            android:layout_height="2dp"
                            android:layout_weight="1"
                            android:layout_marginBottom="24dp"
                            android:id="@+id/vLine2"
                            android:background="#CBD5E1"/>

                        <!-- 완료 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:gravity="center"
                                android:id="@+id/tvStep3Circle"
                                android:text="✓"
                                android:textColor="#64748B"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:background="@drawable/progress_pending_circle"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/tvStep3Label"
                                android:text="처리 완료"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#64748B"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- 상세 내용 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="민원 내용"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#1E293B"
                    android:layout_marginTop="28dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvDescription"
                    android:text="보도블록 일부가 심하게 파손되어 보행자 안전사고 위험이 큽니다. 특히 야간에는 시야 확보가 어려워 빠른 조치가 필요합니다."
                    android:textSize="15sp"
                    android:textColor="#475569"
                    android:lineSpacingExtra="6dp"
                    android:layout_marginTop="12dp"/>

                <!-- 위치 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="발생 위치"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#1E293B"
                    android:layout_marginTop="28dp"/>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="12dp"
                    android:scaleType="centerCrop"
                    android:id="@+id/ivMapImage"
                    android:background="@drawable/map_rounded_bg"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvAddress"
                    android:text="📍 경기도 시흥시 정왕동 배곧생명공원 입구"
                    android:textSize="14sp"
                    android:textColor="#334155"
                    android:padding="14dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/location_box_bg"/>

            </LinearLayout>

            <!-- 담당 부서 답변 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="24dp"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="@drawable/detail_card_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvDeptTitle"
                    android:text="시청 담당 부서 답변"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#1E293B"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvDeptInfo"
                    android:text="도로관리과 | 2024.05.21"
                    android:textSize="13sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvDeptReply"
                    android:text="현장 확인 결과 즉각적인 보수가 필요하여 금주 내 공사를 진행할 예정입니다."
                    android:textSize="14sp"
                    android:textColor="#475569"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 하단 공감바 -->
    <LinearLayout
        android:id="@+id/bottomActionBar"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:paddingHorizontal="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:elevation="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEmpathyCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💙 128"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="#65C0C1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="공감 수"
                android:textSize="12sp"
                android:textColor="#94A3B8"/>
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <android.widget.Button
            android:layout_width="180dp"
            android:layout_height="58dp"
            android:id="@+id/btnEmpathy"
            android:text="공감하기"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:textSize="18sp"
            android:background="@drawable/re_category_selected_bg"/>
    </LinearLayout>

</RelativeLayout>