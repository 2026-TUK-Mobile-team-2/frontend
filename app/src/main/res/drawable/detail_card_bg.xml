<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 카드 배경 -->
    <solid android:color="#FFFFFF" />

    <!-- 둥근 모서리 -->
    <corners android:radius="24dp" />

    <!-- 연한 테두리 -->
    <stroke
        android:width="1dp"
        android:color="#E2E8F0" />

    <!-- 내부 여백용 기본 형태 -->
    <padding
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="0dp" />

</shape>